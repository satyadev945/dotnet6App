{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "",
    "InMemoryConnection": "InMemoryDb"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "SampleDotNet6App",
    "Audience": "SampleDotNet6App",
    "ExpiryInDays": 7
  },
  "ApiSettings": {
    "Title": "Sample .NET 6 API",
    "Version": "v1.0",
    "Description": "A comprehensive sample API for testing .NET version upgrades",
    "EnableSwagger": true,
    "EnableCors": true
  }
}
