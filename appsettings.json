{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:3000",
    "http://localhost:4200",
    "https://localhost:5001"
  ],
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=SampleDotNet6Db;Trusted_Connection=true;MultipleActiveResultSets=true",
    "InMemoryConnection": "InMemoryDb"
  },
  "Jwt": {
    "Key": "your-super-secret-jwt-key-that-is-at-least-256-bits-long-for-security-purposes-12345678901234567890",
    "Issuer": "SampleDotNet6App",
    "Audience": "SampleDotNet6App",
    "ExpiryInDays": 7
  },
  "ApiSettings": {
    "Title": "Sample .NET 8 API",
    "Version": "v1.0",
    "Description": "A comprehensive sample API for testing .NET version upgrades",
    "EnableSwagger": true,
    "EnableCors": true
  }
}
