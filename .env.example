# Environment Variables Configuration Example
# Copy this file to .env and fill in the actual values
# NEVER commit .env file to source control

# Database Configuration
# Required for production deployment
# For AWS RDS SQL Server, use format: Server=<rds-endpoint>.rds.amazonaws.com,1433;Database=<dbname>;User Id=<user>;Password=<password>;Encrypt=true;TrustServerCertificate=false;
DATABASE_CONNECTION_STRING=Server=localhost;Database=SampleDotNet6Db;User Id=sa;Password=YourPassword123!;Encrypt=true;TrustServerCertificate=true;

# JWT Authentication Configuration
# Required: Must be at least 32 characters long
# Generate a secure random key for production
JWT_SECRET_KEY=your-super-secret-jwt-key-that-is-at-least-256-bits-long-for-security-purposes-12345678901234567890

# Optional: JWT Issuer (defaults to "SampleDotNet6App")
JWT_ISSUER=SampleDotNet6App

# Optional: JWT Audience (defaults to "SampleDotNet6App")
JWT_AUDIENCE=SampleDotNet6App

# CORS Configuration
# Optional: Comma-separated list of allowed origins (defaults to "*")
# For production, specify exact origins: https://myapp.example.com,https://admin.example.com
# For development, use "*" to allow all origins
CORS_ALLOWED_ORIGINS=*

# AWS Deployment Notes:
# - Store JWT_SECRET_KEY in AWS Secrets Manager
# - Store DATABASE_CONNECTION_STRING in AWS Secrets Manager
# - Reference secrets in ECS task definition or Elastic Beanstalk configuration
# - Use IAM roles for service-to-service authentication
# - Enable CloudWatch logging for monitoring
