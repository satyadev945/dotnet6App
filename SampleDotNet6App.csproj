<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- JWT Bearer Authentication - updated for .NET 10 compatibility -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <!-- ASP.NET Core built-in OpenAPI support - upgraded to 10.0.12 to resolve Microsoft.OpenApi 2.0.0 vulnerability (GHSA-v5pm-xwqc-g5wc) -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- Entity Framework Core 10 - updated from 6.0.0 for .NET 10 compatibility -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <!-- Newtonsoft.Json - latest stable version -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- System.IdentityModel.Tokens.Jwt - updated to latest version compatible with .NET 10 -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.4.0" />
    <!-- AutoMapper - upgraded to 13.0.1 to resolve high severity vulnerability (GHSA-rvv3-g6hj-g44x).
         AutoMapper 13+ includes DI extension built-in; AutoMapper.Extensions.Microsoft.DependencyInjection removed. -->
    <PackageReference Include="AutoMapper" Version="15.1.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
